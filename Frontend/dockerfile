# Étape 1 : Build du frontend
FROM node:20-alpine AS build

WORKDIR /app-frontend

COPY package*.json ./
RUN npm install --legacy-peer-deps

# Copier le projet
COPY . .

# Copier index.html depuis public/ vers la racine pour Vite
RUN if [ -f public/index.html ]; then cp public/index.html ./index.html; fi

# Corriger le chemin du script dans index.html (remplacer tous les chemins relatifs vers src/)
RUN if [ -f index.html ]; then \
      sed -i 's@\.\./src/@./src/@g' index.html && \
      sed -i 's@"/src/@"./src/@g' index.html; \
    fi

# Build de l'application
RUN npm run build

# Étape 2 : Image finale avec Nginx
FROM nginx:alpine
WORKDIR /usr/share/nginx/html

# Copier la build produite par Vite
COPY --from=build /app-frontend/dist /usr/share/nginx/html

# Copier la config nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]