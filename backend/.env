# .env file for the backend configuration:

DISABLE_REDIS=false

DB_NAME= blablabook
DB_USERNAME= blablabook
DB_PASSWORD= blablabook
DB_HOST= localhost
DB_PORT= 5432
DB_DIALECT= postgres 
# JWT_SECRET= test_clef_secrete
JWT_SECRET= si_tu_arrive_a_lire_ca_tu_es_un_genie
JWT_REFRESH_SECRET= decode_moi_si_tu_as_du_temps_a_perdre
# Durées optionnelles ( configurables)
JWT_ACCESS_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=90d
JWT_REMEMBER_ME_EXPIRATION=30d
# Redis Configuration
REDIS_HOST=myapp_redis
# REDIS_HOST=127.0.0.1
REDIS_URL=redis://redis:6379
REDIS_PORT=6379
REDIS_PASSWORD=CaveCanem


